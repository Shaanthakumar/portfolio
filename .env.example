# =========================================================================
# SMTP CREDENTIALS AND INBOX CONFIGURATION
# Replace the placeholder values below with your real credentials.
# =========================================================================

# SMTP Server Host:
# - For Gmail: smtp.gmail.com
# - For Outlook / Hotmail: smtp-mail.outlook.com
# - For Brevo: smtp-relay.brevo.com
# - For Yahoo: smtp.mail.yahoo.com
SMTP_HOST=smtp.gmail.com

# SMTP Port: 587 (TLS - recommended) or 465 (SSL)
SMTP_PORT=587

# Set to true only if using port 465 (SSL)
SMTP_SECURE=false

# Your email used to authenticate and send the message
# (e.g., yourpersonalemail@gmail.com)
SMTP_USER=YOUR_EMAIL@gmail.com

# App Password generated from your email account
# For Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASS=YOUR_16_DIGIT_APP_PASSWORD

# The email address where you want to receive inquiries
RECIPIENT_EMAIL=YOUR_INBOX_EMAIL@gmail.com

# Port for the backend server
PORT=5000
